{
  "name": "Test PWA",
  "short_name": "TPWA",
  "description": "A test Github Page as a Progressive Web App",
  "scope": "/test-pwa/",
  "start_url": "/test-pwa/",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "display": "standalone", 
  "icons": [
      {
        "src": "/test-pwa/img/icon.png",
        "type": "image/png",
        "sizes": "700x700"
      },
      {
        "src": "/test-pwa/img/web-app-manifest-192x192.png",
        "sizes": "192x192",
        "type": "image/png",
        "purpose": "maskable"
    },
    {
        "src": "/test-pwa/img/web-app-manifest-512x512.png",
        "sizes": "512x512",
        "type": "image/png",
        "purpose": "maskable"
    }
  ]
}
